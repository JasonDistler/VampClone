# ---------------------------------------------------------------------------
# Sir Velorian's Last Stand — .gitignore
# ---------------------------------------------------------------------------

# Dependencies (re-installed by `npm install`)
node_modules/

# Build output (regenerated by `npm run build:win`)
dist/
out/
build/win/
build/dist/
*.exe
*.zip

# macOS app packaging artifacts (regenerated by mac build script)
mac-pkg/build/
mac-pkg/*.app/
mac-pkg/dist/

# OS / editor cruft
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs and runtime data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Stray shell artifacts
sh-thd-*

# Local env / secrets
.env
.env.local
.env.*.local

# Cache
.cache/
.parcel-cache/
.eslintcache

# Coverage
coverage/
.nyc_output/
